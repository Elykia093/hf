{
  "name": "hf-space-wake",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "每天检查 Hugging Face Space 状态，并在休眠时通过 API 唤醒",
  "engines": { "node": ">=24" },
  "scripts": {
    "wake": "node scripts/wake-space.mjs",
    "keepalive": "playwright test --project=live",
